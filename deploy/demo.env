# Fill after deploy. Copy to web/.env.local and keeper/.env.

WAGR_ESCROW=0x0000000000000000000000000000000000000000
WAGR_SEASON=0x0000000000000000000000000000000000000000
WAGR_FACTORY=0x0000000000000000000000000000000000000000
USDSO=0x0000000000000000000000000000000000000000

NEXT_PUBLIC_WAGR_ESCROW=$WAGR_ESCROW
NEXT_PUBLIC_WAGR_SEASON=$WAGR_SEASON
NEXT_PUBLIC_WAGR_FACTORY=$WAGR_FACTORY
NEXT_PUBLIC_USDSO=$USDSO
NEXT_PUBLIC_RPC_HTTP=https://api.infra.testnet.somnia.network
NEXT_PUBLIC_RPC_WS=wss://api.infra.testnet.somnia.network/ws
NEXT_PUBLIC_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
NEXT_PUBLIC_APP_URL=https://wagr-app.vercel.app

# Keeper
SUBSCRIPTION_OWNER_PK=0x<pk_that_holds_>=32_SOMI/STT>
KEEPER_PK=0x<pk_for_fallback_settleDuel_calls>
POLL_INTERVAL_MS=5000

# Deployer
DEPLOYER_PK=0x<pk>
FEE_SINK=0x<address>
REACTIVITY_PRECOMPILE=0x0000000000000000000000000000000000000100

# Seed
DEMO_MAKER_PK=0x<pk>
DEMO_MARKET=0x<BinaryMarket clone address from listBinaryMarkets>
DEMO_STAKE=100000000    # 100 USDso (6 decimals)
DEMO_MAKER_SIDE=0
